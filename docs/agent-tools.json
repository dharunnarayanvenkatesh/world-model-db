{
  "api_version": "v1",
  "description": "Function-calling contracts for evidence-backed shared agent memory.",
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "wm_register_agent",
        "description": "Register an AI agent as a first-class provenance source.",
        "parameters": {
          "type": "object",
          "properties": {
            "agent_id": { "type": "string" },
            "name": { "type": "string" },
            "model": { "type": "string" },
            "capabilities": { "type": "array", "items": { "type": "string" } },
            "priority": { "type": "integer", "default": 0 }
          },
          "required": ["agent_id", "name"]
        }
      },
      "http": { "method": "POST", "path": "/agent/register" }
    },
    {
      "type": "function",
      "function": {
        "name": "wm_remember",
        "description": "Append an idempotent, immutable agent memory with temporal and provenance metadata.",
        "parameters": {
          "type": "object",
          "properties": {
            "agent_id": { "type": "string" },
            "session_id": { "type": "string" },
            "idempotency_key": { "type": "string" },
            "subject_entity_id": { "type": "string" },
            "predicate": { "type": "string" },
            "object": {},
            "object_type": { "type": "string", "enum": ["string", "entity", "integer", "float", "boolean", "timestamp", "json"] },
            "observed_at": { "type": "string", "description": "RFC 3339 source observation time; offsets are normalized to UTC" },
            "claimed_valid_from": { "type": "string", "description": "RFC 3339 start of the claimed world-time interval; defaults to observed_at" },
            "claimed_valid_to": { "type": "string", "description": "Exclusive RFC 3339 end of the claimed world-time interval" },
            "cardinality": { "type": "string", "enum": ["single", "multi"], "default": "single" },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1, "default": 1 },
            "importance": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.5 },
            "tags": { "type": "array", "items": { "type": "string" } },
            "memory_kind": { "type": "string", "enum": ["fact", "decision", "task", "preference", "reflection", "message"], "default": "fact" },
            "raw_payload": { "type": "string" }
          },
          "required": ["agent_id", "session_id", "idempotency_key", "subject_entity_id", "predicate", "object", "observed_at"]
        }
      },
      "http": { "method": "POST", "path": "/agent/memory" }
    },
    {
      "type": "function",
      "function": {
        "name": "wm_context",
        "description": "Build a compact, ranked and token-budget-friendly world context bundle for an agent.",
        "parameters": {
          "type": "object",
          "properties": {
            "agent_id": { "type": "string" },
            "session_id": { "type": "string" },
            "entity_ids": { "type": "array", "items": { "type": "string" } },
            "predicates": { "type": "array", "items": { "type": "string" } },
            "valid_at": { "type": "string" },
            "known_at": { "type": "string" },
            "max_facts": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 32 },
            "char_budget": { "type": "integer", "minimum": 256, "maximum": 1000000, "default": 12000 },
            "include_conflicts": { "type": "boolean", "default": true }
          },
          "required": ["agent_id"]
        }
      },
      "http": { "method": "POST", "path": "/agent/context" }
    },
    {
      "type": "function",
      "function": {
        "name": "wm_explain",
        "description": "Explain why a fact exists, including supporting and conflicting evidence.",
        "parameters": {
          "type": "object",
          "properties": { "fact_id": { "type": "string" } },
          "required": ["fact_id"]
        }
      },
      "http": { "method": "GET", "path_template": "/facts/{fact_id}/why" }
    },
    {
      "type": "function",
      "function": {
        "name": "wm_path",
        "description": "Find a bounded, temporally filtered relationship path between entities.",
        "parameters": {
          "type": "object",
          "properties": {
            "from": { "type": "string" },
            "to": { "type": "string" },
            "max_depth": { "type": "integer", "minimum": 1, "default": 5 },
            "relationship_type": { "type": "string" },
            "valid_at": { "type": "string" }
          },
          "required": ["from", "to"]
        }
      },
      "http": { "method": "GET", "path": "/graph/path" }
    },
    {
      "type": "function",
      "function": {
        "name": "wm_define_ontology",
        "description": "Register a durable ontology schema, module, interface, object/link type, computed property, inference rule, action, permission, or source mapping.",
        "parameters": {
          "type": "object",
          "properties": {
            "kind": { "type": "string", "enum": ["schema", "module", "interface", "object_type", "relationship_type", "computed_property", "inference_rule", "derived_class", "action", "permission", "mapping"] },
            "id": { "type": "string" },
            "name": { "type": "string" },
            "version": { "type": "integer", "minimum": 1 },
            "target_type": { "type": "string" },
            "properties": { "type": "string", "description": "Semicolon-separated name:type:min:max property specs" },
            "expression": { "type": "string" },
            "effects": { "type": "string" },
            "conditions": { "type": "string" }
          },
          "required": ["kind"],
          "additionalProperties": true
        }
      },
      "http": { "method": "POST", "path": "/ontology/definitions" }
    },
    {
      "type": "function",
      "function": {
        "name": "wm_semantic_query",
        "description": "Select typed world objects, filter on ontology properties, traverse semantic links, apply valid time, and aggregate without knowing raw source schemas.",
        "parameters": {
          "type": "object",
          "properties": {
            "object_type": { "type": "string" },
            "conditions": { "type": "string", "description": "Semicolon-separated property:operator:type:value conditions" },
            "from_entity": { "type": "string" },
            "traverse_relationship": { "type": "string" },
            "max_depth": { "type": "integer", "minimum": 1, "default": 5 },
            "valid_at": { "type": "string" },
            "include_inferred": { "type": "boolean", "default": true }
          }
        }
      },
      "http": { "method": "POST", "path": "/ontology/query" }
    },
    {
      "type": "function",
      "function": {
        "name": "wm_execute_action",
        "description": "Execute an ontology action after role, permission, type, precondition, invariant, and postcondition checks.",
        "parameters": {
          "type": "object",
          "properties": {
            "action": { "type": "string" },
            "actor": { "type": "string" },
            "roles": { "type": "array", "items": { "type": "string" } },
            "target": { "type": "string" }
          },
          "required": ["action", "actor", "target"]
        }
      },
      "http": { "method": "POST", "path_template": "/ontology/actions/{action}/execute" }
    },
    {
      "type": "function",
      "function": {
        "name": "wm_materialize_ontology",
        "description": "Materialize computed properties and graph inference rules into versioned world state.",
        "parameters": { "type": "object", "properties": {} }
      },
      "http": { "method": "POST", "path": "/ontology/materialize" }
    },
    {
      "type": "function",
      "function": {
        "name": "wm_apply_mapping",
        "description": "Apply a registered source mapping to a raw source record and upsert its validated semantic entity.",
        "parameters": {
          "type": "object",
          "properties": {
            "mapping_id": { "type": "string" },
            "record": { "type": "object", "additionalProperties": true }
          },
          "required": ["mapping_id", "record"]
        }
      },
      "http": { "method": "POST", "path_template": "/ontology/mappings/{mapping_id}/apply", "body": "record" }
    },
    {
      "type": "function",
      "function": {
        "name": "wm_check_ontology",
        "description": "Check type hierarchy, properties, relationship constraints, disjointness, required existence, acyclicity, and module dependencies.",
        "parameters": { "type": "object", "properties": {} }
      },
      "http": { "method": "GET", "path": "/ontology/consistency" }
    },
    {
      "type": "function",
      "function": {
        "name": "wm_register_twin",
        "description": "Register a domain-neutral digital twin backed by the bitemporal world model.",
        "parameters": {
          "type": "object",
          "properties": {
            "kind": { "type": "string", "description": "Domain classification or model URI, such as manufacturing.machine or software.service" },
            "name": { "type": "string" },
            "model_id": { "type": "string", "description": "External DTDL, AAS, NGSI-LD, or application model identifier" },
            "schema_version": { "type": "string" },
            "capabilities": { "type": "array", "items": { "type": "string" } },
            "external_ids": { "type": "object", "additionalProperties": { "type": "string" } }
          },
          "required": ["kind", "name"]
        }
      },
      "http": { "method": "POST", "path": "/twins" }
    },
    {
      "type": "function",
      "function": {
        "name": "wm_report_twin_signal",
        "description": "Append timestamped reported telemetry to a twin with source, quality, unit, and bitemporal metadata.",
        "parameters": {
          "type": "object",
          "properties": {
            "twin_id": { "type": "string" },
            "signal": { "type": "string" },
            "value": {},
            "value_type": { "type": "string", "enum": ["string", "entity", "integer", "float", "boolean", "timestamp", "json"] },
            "observed_at": { "type": "string" },
            "ingested_at": { "type": "string" },
            "valid_from": { "type": "string" },
            "valid_to": { "type": "string" },
            "unit": { "type": "string" },
            "quality": { "type": "string" },
            "sequence": { "type": "string" },
            "adapter_id": { "type": "string", "default": "rest" },
            "protocol": { "type": "string", "default": "http-json" },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1, "default": 1 }
          },
          "required": ["twin_id", "signal", "value", "observed_at"]
        }
      },
      "http": { "method": "POST", "path_template": "/twins/{twin_id}/telemetry", "omit_from_body": ["twin_id"] }
    },
    {
      "type": "function",
      "function": {
        "name": "wm_get_twin_state",
        "description": "Get reported, desired, configuration, and derived twin state plus drift and conflicts at valid-time and known-time coordinates.",
        "parameters": {
          "type": "object",
          "properties": {
            "twin_id": { "type": "string" },
            "valid_at": { "type": "string" },
            "known_at": { "type": "string" }
          },
          "required": ["twin_id"]
        }
      },
      "http": { "method": "GET", "path_template": "/twins/{twin_id}/state" }
    },
    {
      "type": "function",
      "function": {
        "name": "wm_command_twin",
        "description": "Request an auditable, expiring, idempotent command for a digital twin.",
        "parameters": {
          "type": "object",
          "properties": {
            "twin_id": { "type": "string" },
            "command_type": { "type": "string" },
            "requested_by": { "type": "string" },
            "requested_at": { "type": "string" },
            "expires_at": { "type": "string" },
            "idempotency_key": { "type": "string" },
            "parameters": { "type": "object", "additionalProperties": true }
          },
          "required": ["twin_id", "command_type", "requested_by", "idempotency_key"]
        }
      },
      "http": { "method": "POST", "path_template": "/twins/{twin_id}/commands", "omit_from_body": ["twin_id"] }
    }
  ]
}
